# AutoBroker (TS) — local environment template.
# Copy to `.env` and fill in. `.env` is gitignored; never commit real keys.
#
# Provider keys: AutoBroker supports three first-class, switchable api-key
# providers. Set the one you intend to use; the others may stay blank.
# Provider selection is policy-driven (useCase -> ModelAlias) inside
# packages/model — you do not hardcode a provider name in workflow code.

# --- DeepSeek (DEFAULT provider + live-harness test agent) --------------------
# Default api-key provider AND the agent that runs the live-harness test suite
# on the real corpus. Endpoint: https://api.deepseek.com
# PRIVACY: per DeepSeek's privacy policy, your inputs / prompts / uploaded files
# (which include your private Gmail content and dealer PII) are stored in the PRC
# and may be used for training. See "Privacy" in README.md before configuring.
# If you do not accept this, leave this blank and set ANTHROPIC_API_KEY or
# OPENAI_API_KEY instead.
DEEPSEEK_API_KEY=

# --- Anthropic (alternate, first-class) --------------------------------------
# Set this instead of DEEPSEEK_API_KEY to route LLM calls to Anthropic (Claude).
ANTHROPIC_API_KEY=

# --- OpenAI (alternate, first-class) -----------------------------------------
# Set this instead of DEEPSEEK_API_KEY to route LLM calls to OpenAI.
OPENAI_API_KEY=

# --- Google Places (dealer discovery) ----------------------------------------
# Used by the geosearch / dealer-discovery tools for Maps-based lookups.
GOOGLE_PLACES_API_KEY=

# --- Data directory ----------------------------------------------------------
# Parity-period data dir, isolated from the legacy Python repo's ~/.autobroker/.
# Holds the cold-copied SQLite DB, logs, and config for AutoBroker (TS).
AUTOBROKER_DATA_DIR=~/.autobroker-ts

# --- Safety fuse -------------------------------------------------------------
# Redundant outer circuit-breaker: when =1, the Gmail-send / browser-submit
# wrappers throw before any real external mutation. Kept ARMED at all times.
# This is the FUSE, never the only floor — the load-bearing barrier is the
# in-process L2 gate (see CLAUDE.md, gate stack). Set to 0 only for an
# explicitly approved real-send run with a human approving in the dashboard.
AUTOBROKER_BLOCK_EXTERNAL_MUTATIONS=1

# --- Mastra telemetry kill ----------------------------------------------------
# Local-first invariant (Phase 0, network-verified): Mastra phones home to
# PostHog unless disabled. MUST be set to 1 BEFORE the Mastra instance is
# constructed; the boot sequence in apps/server sets it defensively, but keep it
# in the environment too. Zero PostHog egress is a CI-checked invariant.
MASTRA_TELEMETRY_DISABLED=1

# --- Dev-surface toggle ------------------------------------------------------
# 0 = consumer surface (default). 1 = dev surface (raw skill run, doctor,
# fixtures, force-override audit, the 40+ AUTOBROKER_* knobs). The human
# approval for the 3 irreversible skills is NEVER hidden, on either surface.
AUTOBROKER_DEV=0
