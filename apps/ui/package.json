{
  "name": "@autobroker/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Layer 5 (app) — React/Vite + AI SDK UI chat rail (dashboard SPA). Vite + React 18 + TS strict, the typed API client, the single SSE hook (useRunStream), and the Zustand chat store (hand-rolled SSE; AI SDK UI wiring not yet landed).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e:build": "pnpm --filter @autobroker/server build && pnpm --filter @autobroker/ui build",
    "e2e": "pnpm run e2e:build && node e2e/run.mjs",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@autobroker/core": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@autobroker/server": "workspace:*",
    "@autobroker/tools": "workspace:*",
    "@autobroker/workflows": "workspace:*",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "happy-dom": "^15.0.0",
    "playwright": "^1.60.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.0"
  }
}
