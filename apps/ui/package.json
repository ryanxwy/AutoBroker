{
  "name": "@autobroker/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Layer 5 (app) — React/Vite + AI SDK UI chat rail (dashboard SPA). Vite + React 18 + TS strict, the typed API client, and the single App-level useChat (@ai-sdk/react over the /stream-v2 UI-message-stream).",
  "type": "module",
  "main": "./dist/index.js",
