    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@ai-sdk/react": "3.0.202",
    "@autobroker/core": "workspace:*",
    "@fontsource-variable/archivo": "^5.2.8",
