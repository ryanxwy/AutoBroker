    "@fontsource/fragment-mono": "^5.2.8",
    "ai": "6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@autobroker/model": "workspace:*",
    "@autobroker/server": "workspace:*",
    "@autobroker/tools": "workspace:*",
    "@autobroker/workflows": "workspace:*",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "happy-dom": "^15.0.0",
    "playwright": "^1.60.0",
    "typescript": "^5.6.0",
