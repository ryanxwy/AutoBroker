{
  "name": "@autobroker/workflows",
  "version": "0.0.0",
  "private": true,
  "description": "Layer 3 — Mastra 1.x workflow backbone for the 17 flat skill workflows. Owns durable suspend/resume projection, Memory-thread session plumbing, fallback orchestration, and L2 gate routing without touching the product DB or external APIs directly.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@autobroker/core": "workspace:*",
    "@autobroker/model": "workspace:*",
    "@autobroker/skills": "workspace:*",
    "@autobroker/tools": "workspace:*",
    "@mastra/core": "1.41.0",
    "@mastra/libsql": "1.12.1",
    "@mastra/memory": "1.20.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^4.0.0"
  }
}
