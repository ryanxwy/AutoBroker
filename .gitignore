.claude/.skill-loop-active

# OS
.DS_Store

# Cold-copied legacy SQLite for drizzle-kit pull (copy-not-share scratch)
.cold-copy/

# subagent-driven-development scratch handoff reports (never committed)
.sdd-reports/

# Playwright-MCP / UX-review scratch (browser-driven session artifacts)
.playwright-mcp/
.ux-review/

# Loose screenshots dumped at repo root by e2e / UI runs
